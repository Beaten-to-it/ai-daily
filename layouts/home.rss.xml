{{- $pages := where .Site.RegularPages "Section" "daily" -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Site.Title | transform.XMLEscape | safeHTML }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Title | transform.XMLEscape | safeHTML }}</description>
    <language>{{ .Site.Language.LanguageCode }}</language>
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range first 30 $pages.ByDate.Reverse }}
    <item>
      <title>{{ .LinkTitle | transform.XMLEscape | safeHTML }}</title>
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
    </item>
    {{- end }}
  </channel>
</rss>
